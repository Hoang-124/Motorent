PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/motorent_db
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/motorent_test
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173
TRUST_PROXY=1

# Email config (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@motorent.vn
SMTP_PASS=your_smtp_app_password

# VNPay Sandbox
VNP_TMNCODE=DEMO_CODE
VNP_HASHSECRET=DEMO_SECRET
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=http://localhost:5173/vnpay-return

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Default initial password for database seeders
SEED_PASSWORD=Motorent@2026
