<mxfile host="Electron">
  <diagram id="motorent-complete-overview" name="Overview-Use-Case-Diagram">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ================= SYSTEM BOUNDARY ================= -->
        <mxCell id="sys_box" value="Overview Use Case Diagram - MOTORENT System" style="shape=rect;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.8;rounded=0;spacingTop=10;fontColor=#064e3b;" vertex="1" parent="1">
