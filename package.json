{
  "name": "motorent-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "MOTORENT - Motorbike Rental Chain Management System Workspace",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test:tai": "node scripts/test-tai.cjs",
    "check:tai-runtime": "node scripts/check-tai-runtime.cjs",
    "publish:rental-policy": "npm --prefix server run publish:rental-policy",
    "health": "powershell -Command \"Invoke-RestMethod -Uri 'http://localhost:5000/api/health'\""
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "docx": "^9.7.2"
  }
}
